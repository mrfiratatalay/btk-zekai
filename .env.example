# Copy to .env for local Docker Compose runs.
# AI service returns a clear configuration error if this is empty.
GOOGLE_API_KEY=your_google_ai_studio_key
GEMINI_BUNDLE_MODEL=gemini-2.5-flash-lite
GEMINI_BUNDLE_THINKING_BUDGET=0

# Browser-facing public URLs
NEXT_PUBLIC_COMMERCE_API_URL=http://localhost:5001
NEXT_PUBLIC_ZEKAI_API_URL=http://localhost:5002
NEXT_PUBLIC_COMMERCE_WEB_URL=http://localhost:3000

# Container-internal service URLs
CommerceApi__BaseUrl=http://commerce-api:8080
AiService__BaseUrl=http://ai-service:8000
