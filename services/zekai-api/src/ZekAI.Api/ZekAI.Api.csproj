    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZekAI.Application\ZekAI.Application.csproj" />
    <ProjectReference Include="..\ZekAI.Infrastructure\ZekAI.Infrastructure.csproj" />
  </ItemGroup>

