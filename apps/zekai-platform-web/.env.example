# ZekAI Platform Web - Environment Variables
# Bu dosyayi .env.local olarak kopyalayin: copy .env.example .env.local
# start-frontends.bat bunu otomatik yapar.

# ZekAI API (Docker'da calisiyor - localhost:5002)
NEXT_PUBLIC_API_URL=http://localhost:5002
NEXT_PUBLIC_ZEKAI_API_URL=http://localhost:5002

# Commerce API (Docker'da calisiyor - localhost:5001)
NEXT_PUBLIC_COMMERCE_API_URL=http://localhost:5001

# Akilli Market frontend URL
NEXT_PUBLIC_COMMERCE_WEB_URL=http://localhost:3000

# AI Agent ozelligi
NEXT_PUBLIC_ENABLE_ADK_AGENT=false
